\@writefile{lof}{\contentsline {figure}{\numberline {8.4}{\ignorespaces 重叠分布函数法与Widom粒子插入方案在测量Lennard-Jones流体化学势（$T = 1.2$）时的比较。实线为粒子插入结果，虚线为重叠分布法（$\beta \mu ^{\text  {ex}} = f_1 - f_0$）的结果。$\beta \mu ^{\text  {ex}}$ 的单位与 $f(\Delta U)$ 相同。左图对应于中等密度的液体（$\rho = 0.7$）。在此情况下，两个分布重叠，两种方法给出一致的结果。右图对应于高密度液体（$\rho = 1.00$）。在此情况下，插入概率非常低。分布 $f_0$ 和 $f_1$ 几乎不重叠，$\beta \mu ^{\text  {ex}}$ 的两种不同估计不一致。}}{211}{figure.8.4}\protected@file@percent }
\newlabel{fig:8_4}{{8.4}{211}{重叠分布函数法与Widom粒子插入方案在测量Lennard-Jones流体化学势（$T = 1.2$）时的比较。实线为粒子插入结果，虚线为重叠分布法（$\beta \mu ^{\text {ex}} = f_1 - f_0$）的结果。$\beta \mu ^{\text {ex}}$ 的单位与 $f(\Delta U)$ 相同。左图对应于中等密度的液体（$\rho = 0.7$）。在此情况下，两个分布重叠，两种方法给出一致的结果。右图对应于高密度液体（$\rho = 1.00$）。在此情况下，插入概率非常低。分布 $f_0$ 和 $f_1$ 几乎不重叠，$\beta \mu ^{\text {ex}}$ 的两种不同估计不一致。}{figure.8.4}{}}
